# Entorno: dev, qa o prod (sin valor = prod, la configuración más estricta).
# dev permite la cookie de sesión por http para probar en la red local.
APP_ENV=prod

# Configuración de correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seguridad de la aplicación
SECRET_KEY=
# URL pública https, sin barra final ni ruta (ej. https://gfd.emasivosas.com.co)
APP_BASE_URL=
# Almacenamiento compartido del límite de intentos de login entre workers de
# Gunicorn (ej. redis://localhost:6379). Obligatorio con varios workers.
RATELIMIT_STORAGE_URI=

# Configuración de base de datos
DB_SERVER=
DB_DATABASE=
# Ej. {ODBC Driver 17 for SQL Server}
DB_DRIVER=
DB_USER=
DB_PASSWORD=
# Segundos para conectar; con la base caída se responde 503 en ese tiempo.
DB_CONNECT_TIMEOUT=3
# Validar el certificado de SQL Server (no). Solo en desarrollo con certificado
# autofirmado: yes. Nunca yes en QA ni producción.
DB_TRUST_SERVER_CERTIFICATE=no

# Carpeta del app.log (rota a los 10 MB, conserva 5). Vacío = backend/logs.
APP_LOG_DIR=

# La carpeta de adjuntos y videos no va aquí: está fija en backend/config.py
# (MEDIA_DIR = /media/emapp/dano_flota, la del servidor de TI).

# Gunicorn (gunicorn.conf.py). Socket Unix detrás de nginx.
GUNICORN_BIND=unix:/var/www/dano_flota/ipc.sock
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
