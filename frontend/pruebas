    <script>
        
        // Selecciona todos los textarea
        const textareas = document.querySelectorAll('textarea');

        // Convierte a mayúsculas mientras se escribe
        textareas.forEach(textarea => {
            textarea.addEventListener('input', () => {
                textarea.value = textarea.value.toUpperCase();
            });
        });


        let t = null;
        let inputAdjuntos = null;
        let listaAdjuntos = null;
        let adjuntosSeleccionados = [];
        let registros = [];
        try {
            const script = document.getElementById('registros-json');
            registros = JSON.parse(script.textContent);
        } catch (e) {
            console.error("Error al parsear registros:", e);
        }

        
        /***********************
         * FESTIVOS COLOMBIA 🇨🇴
         ***********************/

        // Cache por año (mejor rendimiento)
        const festivosPorAnio = {};

        // Pascua
        function calcularPascua(year) {
            const a = year % 19;
            const b = Math.floor(year / 100);
            const c = year % 100;
            const d = Math.floor(b / 4);
            const e = b % 4;
            const f = Math.floor((b + 8) / 25);
            const g = Math.floor((b - f + 1) / 3);
            const h = (19 * a + b - d - g + 15) % 30;
            const i = Math.floor(c / 4);
            const k = c % 4;
            const l = (32 + 2 * e + 2 * i - h - k) % 7;
            const m = Math.floor((a + 11 * h + 22 * l) / 451);
            const month = Math.floor((h + l - 7 * m + 114) / 31);
            const day = ((h + l - 7 * m + 114) % 31) + 1;
            return new Date(year, month - 1, day);
        }

        // Mover festivos al lunes (Ley Emiliani)
        function moverALunes(fecha) {
            const d = fecha.getDay();
            if (d === 1) return fecha;
            const f = new Date(fecha);
            f.setDate(fecha.getDate() + ((8 - d) % 7));
            return f;
        }

        // Generar festivos Colombia
        function generarFestivosColombia(year) {
            const festivos = [];

            // Fijos
            festivos.push(new Date(year, 0, 1));    // Año Nuevo
            festivos.push(new Date(year, 4, 1));    // Día del Trabajo
            festivos.push(new Date(year, 6, 20));   // Independencia
            festivos.push(new Date(year, 7, 7));    // Boyacá
            festivos.push(new Date(year, 11, 8));   // Inmaculada
            festivos.push(new Date(year, 11, 25));  // Navidad

            // Emiliani
            festivos.push(moverALunes(new Date(year, 0, 6)));   // Reyes
            festivos.push(moverALunes(new Date(year, 2, 19)));  // San José
            festivos.push(moverALunes(new Date(year, 5, 29)));  // San Pedro y San Pablo
            festivos.push(moverALunes(new Date(year, 7, 15)));  // Asunción
            festivos.push(moverALunes(new Date(year, 9, 12)));  // Raza
            festivos.push(moverALunes(new Date(year, 10, 1)));  // Todos los Santos
            festivos.push(moverALunes(new Date(year, 10, 11))); // Cartagena

            // Pascua
            const pascua = calcularPascua(year);
            festivos.push(new Date(year, pascua.getMonth(), pascua.getDate() - 3)); // Jueves Santo
            festivos.push(new Date(year, pascua.getMonth(), pascua.getDate() - 2)); // Viernes Santo
            festivos.push(moverALunes(new Date(year, pascua.getMonth(), pascua.getDate() + 43))); // Ascensión
            festivos.push(moverALunes(new Date(year, pascua.getMonth(), pascua.getDate() + 64))); // Corpus
            festivos.push(moverALunes(new Date(year, pascua.getMonth(), pascua.getDate() + 71))); // Sagrado

            return festivos.map(f => f.toISOString().split("T")[0]);
        }

        // Obtener festivos por año
        function obtenerFestivosColombia(year) {
            if (!festivosPorAnio[year]) {
                festivosPorAnio[year] = generarFestivosColombia(year);
            }
            return festivosPorAnio[year];
        }

        /***********************
         * DÍAS HÁBILES
         ***********************/
        function esDiaHabil(fecha) {
            const dia = fecha.getDay();
            if (dia === 0 || dia === 6) return false; // domingo o sábado

            const iso = fecha.toISOString().split("T")[0];
            const festivos = obtenerFestivosColombia(fecha.getFullYear());

            return !festivos.includes(iso);
        }

        /***********************
         * DURACIÓN HÁBIL
         ***********************/
        function calcularDuracionHabil(inicio, fin) {
            let actual = new Date(inicio);
            let totalMs = 0;

            while (actual < fin) {
                if (esDiaHabil(actual)) {
                    let finDia = new Date(actual);
                    finDia.setHours(23, 59, 59, 999);
                    if (finDia > fin) finDia = fin;
                    totalMs += (finDia - actual);
                }
                actual.setDate(actual.getDate() + 1);
                actual.setHours(0, 0, 0, 0);
            }

            const dias = Math.floor(totalMs / 86400000);
            const horas = Math.floor((totalMs % 86400000) / 3600000);
            const minutos = Math.floor((totalMs % 3600000) / 60000);

            return { dias, horas, minutos };
        }




        function renderTabla(lista) {
            const tbody = document.getElementById("tablaRegistros");
            tbody.innerHTML = ""; // Limpiar tabla antes de renderizar

            lista.forEach(registro => {
                let fechaFormateada = "Sin fecha";
                if (registro.fecha) {
                    try {
                        const [anio, mes, dia] = registro.fecha.split('-');
                        fechaFormateada = `${dia}/${mes}/${anio}`;
                    } catch (err) {}
                }

                
                let fechaFormateada_2 = "Sin fecha";
                let duracion = "Desconocida";
                let duracionEvento = "Desconocida";
                let t = null;

                if (registro.fecha_r) {
                    try {
                        const [fechaParte, horaParte] = registro.fecha_r.split(' ');
                        const [dia, mes, anio] = fechaParte.split('/');

                        const fechaISO = `${anio}-${mes}-${dia}T${horaParte || '00:00:00'}`;
                        const fechaInicio = new Date(fechaISO);

                        // Duración desde registro
                        if (!isNaN(fechaInicio)) {
                            const ahora = new Date();
                            t = calcularDuracionHabil(fechaInicio, ahora);
                            duracion = `${t.dias}d ${t.horas}h`;
                        }

                        // Duración desde evento
                        if (registro.fecha) {
                            const fechaEvento = new Date(registro.fecha + "T00:00:00");
                            if (!isNaN(fechaEvento)) {
                                const tEvento = calcularDuracionHabil(fechaEvento, new Date());
                                duracionEvento = `${tEvento.dias}d ${tEvento.horas}h`;
                            }
                        }

                    } catch (err) {
                        console.error("❌ Error procesando fechas:", err);
                    }
                }   

                const tr = document.createElement('tr');

                if (t && t.dias >= 2) {
                    tr.classList.add("row-danger");
                } else {
                    tr.classList.add("row-ok");
                }
                

                tr.innerHTML = `
                    <td>${registro.Id}</td>
                    <td>${fechaFormateada}</td>
                    <td>${registro.Movil}</td>
                    <td>${registro.Codigo}</td>
                    <td>${registro.Nombre}</td>
                    <td>${duracion || ''}</td>
                    <td>${duracionEvento || ''}</td>
                    <td>
                        ${registro.archivos && registro.archivos.length > 0
                        ? `<button class="btn" onclick="mostrarAdjuntos(${registro.Id})">Ver archivos (${registro.archivos.length})</button>`
                        : `<span style="color:#777;">Sin archivos</span>`}
                    </td>
                    <td>
                        <button class="btn btn-success" onclick="abrirModal('${registro.Id}')">Añadir info</button>
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

        // SACAR COORDENADAS DE DIRECCION
        function obtenerCoordsDesdeDireccion(direccion) {
            if (!direccion) return null;

            const partes = direccion.split(',');
            if (partes.length !== 2) return null;

            const lat = parseFloat(partes[0].trim());
            const lon = parseFloat(partes[1].trim());

            if (isNaN(lat) || isNaN(lon)) return null;

            return { lat, lon };
        }


        renderTabla(registros); // inicial

        document.getElementById("filtroUF").addEventListener("change", () => {
            const valor = document.getElementById("filtroUF").value;
            const filtrados = valor === "todos" ? registros : registros.filter(r => String(r.UF) === valor);
            renderTabla(filtrados);
            activarFiltrosColumnas();
        });


        let map;
        let marker;

        document.addEventListener("DOMContentLoaded", () => {
            map = L.map('map').setView([4.65, -74.1], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
        });


        // ===== Mostrar adjuntos (multimedia) =====
        function mostrarAdjuntos(id) {
            
            console.log('ID recibido en la función:', id);
            const registro = registros.find(r => r.Id === id);

            const mtto = (registro.mtto && registro.mtto.length > 0)
                ? registro.mtto[0]
                : null;

            const oper = (registro.oper && registro.oper.length > 0)
                ? registro.oper[0]
                : null;
                


            // 1️⃣ ABRIR MODAL PRIMERO
            document.getElementById('modalAdjuntos').style.display = 'block';

            // MOSTRAR ID EN EL MODAL
            
            document.getElementById('modal_svial1').textContent = id;

            movilSeleccionado = id;

            // 2️⃣ Esperar a que se pinte
            setTimeout(() => {
                map.invalidateSize();

                const coords = obtenerCoordsDesdeDireccion(registro.Direccion);

                if (!coords) {
                    console.warn('Dirección sin coordenadas:', registro.Direccion);
                    return;
                }

                if (marker) map.removeLayer(marker);

                marker = L.marker([coords.lat, coords.lon])
                    .addTo(map)
                    .bindPopup('Ubicación del evento')
                    .openPopup();

                map.setView([coords.lat, coords.lon], 17);

            }, 300);

            const galeria = document.getElementById('galeriaAdjuntos');
            const infoBody = document.getElementById("infoEventoBody");
            const infomtto = document.getElementById("infoEventomtto");
            const infosvial = document.getElementById("infoEventosvial");


            // ===== Formateo del costo =====
            function formatoCOP(valor) {
                if (valor === null || valor === undefined || valor === '') return '--';

                const numero = Number(valor);
                if (isNaN(numero)) return '-';

                return new Intl.NumberFormat('es-CO', {
                    style: 'currency',
                    currency: 'COP',
                    minimumFractionDigits: 0
                }).format(numero);
            }


            // 🆕 Mostrar información del evento
            infoBody.innerHTML = `
            <tr>
                <td data-label="Campo">FECHA EVENTO</td>
                <td data-label="Valor">${registro.fecha || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">MÓVIL</td>
                <td data-label="Valor">${registro.Movil || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">CÓDIGO</td>
                <td data-label="Valor">${registro.Codigo || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">NOMBRE</td>
                <td data-label="Valor">${registro.Nombre || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">AREÁ</td>
                <td data-label="Valor">${registro.Area || '-'}</td>
            </tr>                                      
            <tr>
                <td data-label="Campo">RUTA</td>
                <td data-label="Valor">${registro.Ruta || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">VERSIÓN LIBRE</td>
                <td data-label="Valor">${registro.Version_libre || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">ZONA DEL DAÑO</td>
                <td data-label="Valor">${registro.Zona_dano || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">PARTE AFECTADA</td>
                <td data-label="Valor">${registro.Parte_afectada || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">DAÑO OCASIONADO POR</td>
                <td data-label="Valor">${registro.Dano_ocasionado || '-'}</td>
            </tr>

            <tr>
                <td data-label="Campo">CENTRO OPERACIONES</td>
                <td data-label="Valor">${registro.Centro_operaciones || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">RESPONSABLE DILIGENCIAMIENTO</td>
                <td data-label="Valor">${registro.Registrador || '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">FECHA REGISTRO EVENTO</td>
                <td data-label="Valor">${registro.fecha_r || '-'}</td>
            </tr>                         
            <tr>
                <td data-label="Campo">DIRECCIÓN</td>
                <td data-label="Valor">${registro.Direccion || '-'}</td>
            </tr>            
            `;


            // 🆕 Mostrar información del evento de mantenimiento
            infomtto.innerHTML = `
            <tr>
                <td data-label="Campo">COSTO DEL DAÑO</td>
                <td data-label="Valor">${mtto ? formatoCOP(mtto.Costo) : '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">DAÑO ADICIONAL</td>
                <td data-label="Valor">${mtto ? mtto.dano_adicional : '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">OBSERVACIÓNES</td>
                <td data-label="Valor">${mtto ? mtto.observaciones : '-'}</td>
            </tr>       
            `;

            // 🆕 Mostrar información del evento de operciones
            infosvial.innerHTML = `

            <tr>
                <td data-label="Campo">OBSERVACIÓNES TECNICAS CONTROL OPERACIONAL</td>
                <td data-label="Valor">${oper ? oper.Observaciones_operaciones: '-'}</td>
            </tr>
            <tr>
                <td data-label="Campo">LA INFORMACIÓN CARGADA ES CORRECTA?</td>
                <td data-label="Valor">${oper ? oper.rev_error: '-'}</td>
            </tr> 
            <tr>
                <td data-label="Campo">OBSERVACIÓNES DE DILIGENCIAMIENTO ERRONEO</td>
                <td data-label="Valor">${oper ? oper.observaciones_correctivos: '-'}</td>
            </tr>       
            `;


            galeria.innerHTML = '';


            // 🆕 Archivos
            if (!registro.archivos || registro.archivos.length === 0) {
                galeria.innerHTML = '<p style="text-align:center; color:#777;">Sin archivos adjuntos</p>';
            } else {
                registro.archivos.forEach(file => {
                    const div = document.createElement('div');
                    div.classList.add('adjunto-item');

                    const ext = file.FileName.split('.').pop().toLowerCase();
                    const fileUrl = '/ver_archivo?path=' + encodeURIComponent(file.FilePath);

                    if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) {
                        const img = document.createElement('img');
                        img.src = fileUrl;
                        img.onclick = () => abrirLightbox(fileUrl);
                        div.appendChild(img);
                    } else if (['mp4', 'mov', 'avi', 'webm'].includes(ext)) {
                        const video = document.createElement('video');
                        video.src = fileUrl;
                        video.controls = true;
                        div.appendChild(video);
                    } else {
                        const link = document.createElement('a');
                        link.href = fileUrl;
                        link.target = '_blank';
                        link.textContent = file.FileName;
                        div.appendChild(link);
                    }

                    galeria.appendChild(div);
                });
            }

        }

        function cerrarModalAdjuntos() {
            document.getElementById('modalAdjuntos').style.display = 'none';
        }



        // ===== Lightbox =====
        function abrirLightbox(url) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightbox-img');
            img.src = url;
            lightbox.style.display = 'flex';
        }
        function cerrarLightbox() {
            document.getElementById('lightbox').style.display = 'none';
            document.getElementById('lightbox-img').src = '';
        }

        // Modal seguridad vial
        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("miModal");
            const textareaObs = document.getElementById("observaciones");
            let movilSeleccionado = "";

            //variable de datos adjuntos
            inputAdjuntos = document.getElementById("evidencia");
            listaAdjuntos = document.getElementById("lista_adjuntos");

            inputAdjuntos.addEventListener("change", () => {
                const nuevosArchivos = Array.from(inputAdjuntos.files);
                nuevosArchivos.forEach(file => adjuntosSeleccionados.push(file));
                inputAdjuntos.value = "";
                actualizarListaAdjuntos();
            });



            // Abrir/cerrar modal
            window.abrirModal = (id) => {
                const modal = document.getElementById("miModal");
                modal.style.display = "block";

                movilSeleccionado = id;
                document.getElementById('modal_svial').textContent = id;

                inputAdjuntos = document.getElementById("evidencia");
                listaAdjuntos = document.getElementById("lista_adjuntos");

                if (!inputAdjuntos || !listaAdjuntos) {
                    console.error("❌ Adjuntos no encontrados");
                    return;
                }

                inputAdjuntos.onchange = () => {
                    const nuevos = Array.from(inputAdjuntos.files);
                    nuevos.forEach(f => adjuntosSeleccionados.push(f));
                    inputAdjuntos.value = "";
                    actualizarListaAdjuntos();
                };
            };

            window.cerrarModal = () => {
                document.getElementById("miModal").style.display = "none";
                movilSeleccionado = "";
                adjuntosSeleccionados = [];
                actualizarListaAdjuntos();
            };



            // Formulario
            document.getElementById("formModal").addEventListener("submit", async (event) => {
                event.preventDefault();

                if (!movilSeleccionado) {
                    alert("No se ha seleccionado un registro.");
                    return;
                }

                    const formData = new FormData();
                    const csrfToken = document.querySelector('#formModal input[name="csrf_token"]')?.value;
                    if (csrfToken) formData.append("csrf_token", csrfToken);
                formData.append("Id_damage_to_fleet", movilSeleccionado);
                formData.append("Usuario_registro_svial", document.body.dataset.usuario);
                formData.append("observaciones_1", document.getElementById("observaciones_1").value);


                adjuntosSeleccionados.forEach(file => formData.append("archivos", file));

                try {
                    const response = await fetch("/agregar_svial", { method: "POST", body: formData });
                    const result = await response.json();

                    if (result.status === "success") {
                        alert(result.message);
                        // Eliminar fila del DOM
                        document.querySelectorAll("#tablaRegistros tr").forEach(fila => {
                            if (fila.querySelector("td")?.textContent == movilSeleccionado) fila.remove();
                        });
                        // Limpiar modal
                        movilSeleccionado = "";
                        adjuntosSeleccionados = [];
                        actualizarListaAdjuntos();
                        document.getElementById("observaciones_1").value = "";
                        cerrarModal();
                    } else {
                        alert("Error: " + result.message);
                    }
                } catch (err) {
                    console.error(err);
                    alert("Ocurrió un error al enviar los datos.");
                }
            });
        });




        // Redibuja la lista
        function actualizarListaAdjuntos() {
            listaAdjuntos.innerHTML = "";

            adjuntosSeleccionados.forEach((file, index) => {
                const item = document.createElement("div");
                item.className = "adjunto_item";

                const nombre = document.createElement("span");
                nombre.className = "adjunto_nombre";
                nombre.textContent = file.name;

                const btnDel = document.createElement("button");
                btnDel.className = "btnAdjuntoDelete";
                btnDel.textContent = "❌";
                btnDel.onclick = () => {
                    eliminarAdjunto(index);
                };

                item.appendChild(nombre);
                item.appendChild(btnDel);
                listaAdjuntos.appendChild(item);
            });
        }

        // Eliminar adjunto específico
        function eliminarAdjunto(i) {
            adjuntosSeleccionados.splice(i, 1);
            actualizarListaAdjuntos();
        }




        /* =====================================================
        ⭐ Convertir fecha DD/MM/YYYY a YYYY-MM-DD para filtrar
        ===================================================== */
        function convertirTablaAISO(fechaTexto) {
            if (!fechaTexto || !fechaTexto.includes("/")) return fechaTexto;
            const [dia, mes, anio] = fechaTexto.split("/");
            return `${anio}-${mes.padStart(2, "0")}-${dia.padStart(2, "0")}`;
        }

        /* =====================================================
        ⭐ Filtro por columnas
        ===================================================== */
        function filtrarTabla() {
            const tabla = document.getElementById("tabla-registros");
            const filtros = document.querySelectorAll("thead th input");
            const filas = tabla.querySelectorAll("tbody tr");

            filas.forEach(fila => {
                const celdas = fila.querySelectorAll("td");
                let mostrar = true;

                filtros.forEach(input => {
                    const col = input.dataset.col;
                    if (col === undefined || input.disabled) return;

                    const filtro = input.value.trim();
                    if (!filtro) return;

                    let contenido = celdas[col].innerText.trim();

                    // Si es fecha (input type="date")
                    if (input.type === "date") {
                        contenido = convertirTablaAISO(contenido);
                        if (contenido !== filtro) mostrar = false;
                    } else {
                        if (!contenido.toLowerCase().includes(filtro.toLowerCase())) {
                            mostrar = false;
                        }
                    }
                });

                fila.style.display = mostrar ? "" : "none";
            });
        }

        /* =====================================================
        ⭐ Re-activar filtros (para cuando cambies UF)
        ===================================================== */
        function activarFiltrosColumnas() {
            const filtros = document.querySelectorAll("thead th input");

            filtros.forEach(input => {
                if (!input.disabled) {
                    input.removeEventListener("input", filtrarTabla);
                    input.removeEventListener("change", filtrarTabla);

                    input.addEventListener("input", filtrarTabla);
                    input.addEventListener("change", filtrarTabla);
                }
            });
        }

        /* =====================================================
        ⭐ Filtro por UF
        ===================================================== */
        function filtrarUF() {
            const valor = document.getElementById("filtroUF").value;

            const filtrados = 
                valor === "todos"
                ? registros
                : registros.filter(r => String(r.UF) === valor);

            // LLAMAS A TU MISMA FUNCIÓN QUE YA EXISTE
            renderTabla(filtrados); 

            activarFiltrosColumnas(); 
        }

        /* =====================================================
        ⭐ Inicialización
        ===================================================== */
        document.addEventListener("DOMContentLoaded", () => {
            activarFiltrosColumnas();
            document.getElementById("filtroUF").addEventListener("change", filtrarUF);
        });




    </script>
</body>

